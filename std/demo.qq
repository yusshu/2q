use std.io, std.util

@decorator
class Demo(SuperClass, SuperClass2) {
  
  constructor(
    def str name
  );

  @operator.sum
  Demo plus(Demo demo) {
    ret new Demo(this.name + demo.name)
  }

  @operator.indexing
  str get_at(int index) {
    ret name + index
  }

  void hi(int times) {
    for (int i : range(times)) {
      print(f"ola nena {name} x{i}")
    }
  }
}

priv int sum(int a, int b) {
  ret a + b
}

int main(str[] args) {
  new Demo("Monda").hi(sum(5, 9))
  ret 0
}