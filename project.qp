group me.yushust 
name hello-world 
version test 

repositories [
  https://github.com/poto/
  https://repo.unnamed.team/
]

plugins [ deploy debug ]

lint {
  indent {
    style space
    size 2
  }
}

test {
  use qunit
}

dependencies {
  compile [
    me.yushust.test:test2:0.1.0
  ]
  runtime [
    me.yushust.test:test:0.1.0
  ]
}